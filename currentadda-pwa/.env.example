# ==========================================
# CurrentAdda - Environment Variables Example
# ==========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SITE_URL=https://currentadda.vercel.app

# OneSignal Push Notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# OpenWA WhatsApp Gateway Configuration (Server-Side)
OPENWA_HOST=http://your-openwa-server-ip:2785
OPENWA_API_KEY=your_openwa_api_key
OPENWA_SMS_HOOK_URL=http://your-openwa-server-ip:2785/api/ingress/supabase-otp-hook/currentadda-otp/send-sms
